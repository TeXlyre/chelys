{
	"name": "chelys",
	"private": true,
	"version": "0.4.0",
	"description": "A local desktop companion app for TeXlyre",
	"author": "Fares Abawi <fares@abawi.me> (https://abawi.me)",
	"license": "AGPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "https://github.com/texlyre/chelys.git"
	},
	"type": "module",
	"scripts": {
		"dev": "node scripts/update-version.mjs && vite",
		"typecheck": "tsc --noEmit",
		"lint:biome": "biome check .",
		"lint:biome:fix": "biome check . --max-diagnostics=2000 --reporter=summary --write",
		"build": "node scripts/update-version.mjs && npm run init:submodules && vite build",
		"preview": "vite preview",
		"tauri": "node scripts/update-version.mjs && tauri",
		"init:submodules": "node scripts/init-submodules.mjs",
		"tauri:windows:build": "tauri-windows-bundle build"
	},
	"dependencies": {
		"@picocss/pico": "^2.1.1",
		"@tauri-apps/api": "^2.11.1",
		"@tauri-apps/plugin-autostart": "^2.5.1",
		"@tauri-apps/plugin-clipboard-manager": "^2.3.2",
		"@tauri-apps/plugin-dialog": "^2.7.2",
		"@tauri-apps/plugin-fs": "^2.5.1",
		"@tauri-apps/plugin-opener": "^2.5.4",
		"@tauri-apps/plugin-os": "^2.3.2",
		"filepizza-client": "^2.1.2",
		"hash-wasm": "^4.12.0",
		"idb": "^8.0.3",
		"mime": "^4.1.0",
		"nanoid": "^5.1.16",
		"node-diff3": "^3.2.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"y-indexeddb": "^9.0.12",
		"y-protocols": "^1.0.7",
		"y-webrtc": "^10.3.0",
		"y-websocket": "^3.1.0",
		"yjs": "^13.6.32"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.9",
		"@choochmeque/tauri-windows-bundle": "0.1.28",
		"@tauri-apps/cli": "^2.11.4",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.1.0",
		"typescript": "^7.0.2",
		"vite": "^8.2.2"
	}
}
