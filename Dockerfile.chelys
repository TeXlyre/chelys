ARG SILE_VERSION=0.15.7

FROM node:20-bookworm-slim AS node

WORKDIR /app
RUN npm install --omit=dev --no-audit --no-fund ws@8

FROM ghcr.io/sile-typesetter/sile:v${SILE_VERSION}

USER root

ENV WS_PORT=7040
ENV CACHE_DIR=/workspace/.cache

COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /app/node_modules /app/node_modules

WORKDIR /app

RUN cat > /app/compile-bridge.cjs <<'BRIDGE'
'use strict';

const { WebSocketServer } = require('ws');
const { spawnSync } = require('node:child_process');
const {
	mkdirSync,
	writeFileSync,
	readFileSync,
	rmSync,
	existsSync,
} = require('node:fs');
const path = require('node:path');

const PORT = Number(process.env.WS_PORT || 7040);
const BINARY = process.env.SILE_BIN || 'sile';
const CACHE_ROOT = process.env.CACHE_DIR || '/workspace/.cache';

const server = new WebSocketServer({ host: '0.0.0.0', port: PORT });

function normalizePath(filePath) {
	return path.posix
		.normalize(String(filePath || '').replaceAll('\\', '/'))
		.replace(/^\/+/, '');
}

function isTruthy(value) {
	return value === true || value === 'true' || value === 1 || value === '1';
}

function clearCache() {
	try {
		rmSync(CACHE_ROOT, { recursive: true, force: true });
		return { status: 0, log: 'Cache cleared.', format: '' };
	} catch (error) {
		return {
			status: 1,
			log: error instanceof Error ? error.message : String(error),
			format: '',
		};
	}
}

function compile(request) {
	const options = request.options || {};
	const workDir = path.join(CACHE_ROOT, 'work');

	try {
		rmSync(workDir, { recursive: true, force: true });
		mkdirSync(workDir, { recursive: true });

		const files = Array.isArray(request.files) ? request.files : [];
		const mainFile = normalizePath(request.mainFile);

		if (!mainFile || mainFile === '.' || mainFile.startsWith('../')) {
			return {
				status: 1,
				log: `Invalid main file: ${String(request.mainFile)}`,
				format: request.format,
			};
		}

		for (const file of files) {
			const filePath = normalizePath(file.path);

			if (!filePath || filePath === '.' || filePath.startsWith('../')) {
				throw new Error(`Invalid file path: ${String(file.path)}`);
			}

			const target = path.join(workDir, filePath);
			mkdirSync(path.dirname(target), { recursive: true });
			writeFileSync(target, Buffer.from(file.content, 'base64'));
		}

		const mainFilePath = path.join(workDir, mainFile);

		if (!existsSync(mainFilePath)) {
			return {
				status: 1,
				log: `Main file not found in compile request: ${mainFile}`,
				format: request.format,
			};
		}

		const outputName = 'output.pdf';
		const result = spawnSync(
			BINARY,
			['-o', outputName, mainFile],
			{
				cwd: workDir,
				encoding: 'buffer',
				timeout: 120000,
			},
		);

		let log = Buffer.concat(
			[result.stdout, result.stderr].filter(Boolean),
		).toString('utf8');

		if (result.error) {
			return {
				status: 1,
				log: `${log}${log ? '\n' : ''}${result.error.message}`,
				format: request.format,
			};
		}

		if (result.status !== 0) {
			return {
				status: result.status ?? 1,
				log,
				format: request.format,
			};
		}

		const outputPath = path.join(workDir, outputName);

		if (!existsSync(outputPath)) {
			return {
				status: 1,
				log: `${log}${log ? '\n' : ''}SILE completed without producing ${outputName}.`,
				format: request.format,
			};
		}

		const output = readFileSync(outputPath);

		if (isTruthy(options.export)) {
			log = `${log}${log ? '\n' : ''}Export ready: ${mainFile}`;
		}

		return {
			status: 0,
			log,
			format: request.format || 'pdf',
			mimeType: 'application/pdf',
			output: output.toString('base64'),
		};
	} catch (error) {
		return {
			status: 1,
			log: error instanceof Error ? error.message : String(error),
			format: request.format,
		};
	}
}

function handle(request) {
	const options = request.options || {};

	if (options.action === 'clear-cache') {
		return clearCache();
	}

	return compile(request);
}

server.on('connection', (socket) => {
	socket.on('message', (data) => {
		let request;

		try {
			request = JSON.parse(data.toString());
		} catch {
			socket.send(JSON.stringify({
				status: 1,
				log: 'Invalid JSON request.',
			}));
			return;
		}

		const response = handle(request);

		socket.send(JSON.stringify({
			requestId: request.requestId,
			...response,
		}));
	});
});

server.on('listening', () => {
	console.log(`SILE compile bridge listening on ws://0.0.0.0:${PORT}`);
});

server.on('error', (error) => {
	console.error('SILE compile bridge error:', error);
	process.exitCode = 1;
});
BRIDGE

WORKDIR /workspace

EXPOSE 7040

ENTRYPOINT ["sh", "-c", "exec node /app/compile-bridge.cjs"]